{
  "manifest_version": 3,
  "name": "Organizador de Grupos - Divulgação",
  "version": "2.0.0",

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],

  "host_permissions": [
    "https://www.facebook.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "core/state.js",
        "core/storage.js",
        "core/overlay.js",
        "facebook/selectors.js",
        "facebook/facebook.js",
        "facebook/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}